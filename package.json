{
  "name": "perminister",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:auth": "vitest run tests/auth/storage-history-benchmark.test.ts --reporter=verbose",
    "storage:rebuild-indexes": "node scripts/rebuild-spaces-indexes.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "health": "repnix check",
    "health:dead-code": "knip",
    "health:duplication": "jscpd src",
    "health:architecture": "depcruise --config .dependency-cruiser.cjs -- src",
    "health:docs": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#coverage\" \"#.next\" \"#.repnix\"",
    "health:licenses": "license-checker --production --onlyAllow \"UNLICENSED;MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0;Unlicense;CC-BY-4.0;LGPL-3.0-or-later\"",
    "health:performance": "node scripts/run-lighthouse-ci.mjs lhci autorun",
    "health:bundle": "size-limit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@node-rs/argon2": "^2.2.2",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@size-limit/file": "^14.1.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jscpd": "^5.4.0",
    "knip": "^6.40.0",
    "license-checker": "^25.0.1",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "repnix": "1.0.4",
    "size-limit": "^14.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "smol-toml": "1.9.0",
    "sprintf-js": "1.1.3"
  }
}
