{
  "packageManager": "pnpm@12.18.0",
  "name": "perminister",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "link": "node ../panel-frame-ui/scripts/link-local.mjs",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:auth": "vitest run tests/auth/storage-history-benchmark.test.ts --reporter=verbose",
    "storage:rebuild-indexes": "node scripts/rebuild-spaces-indexes.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "health": "repnix check",
    "health:dead-code": "knip",
    "health:duplication": "jscpd src",
    "health:architecture": "depcruise --config .dependency-cruiser.cjs -- src",
    "health:docs": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#coverage\" \"#.next\" \"#.repnix\"",
    "health:licenses": "license-checker --production --onlyAllow \"UNLICENSED;MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0;Unlicense;CC-BY-4.0;LGPL-3.0-or-later\"",
    "health:performance": "node scripts/run-lighthouse-ci.mjs lhci autorun",
    "health:bundle": "size-limit",
    "health:a11y": "playwright test tests/e2e/guardrails.spec.ts --project=chromium --grep=WCAG",
    "health:visual": "if [ \"$RUN_VISUAL_REGRESSION\" = \"1\" ] || [ \"$(uname)\" = \"Darwin\" ]; then playwright test tests/e2e/guardrails.spec.ts --project=chromium; else echo \"Visual regression runs in the macOS guardrail job.\"; fi",
    "health:interactions": "vitest run tests/ui/user-interactions.test.tsx",
    "health:styles": "stylelint --formatter json \"**/*.{css,pcss,postcss}\"",
    "dev:preview": "PERMINISTER_UI_PREVIEW=1 next dev --webpack --hostname 127.0.0.1 --port 3217"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@node-rs/argon2": "^2.2.2",
    "next": "^16.4.1",
    "panel-frame-ui": "^0.2.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "ui-preview-kit": "^0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.6.6",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^14.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.5.0",
    "jscpd": "^5.4.0",
    "jsdom": "^26.1.0",
    "knip": "^6.40.0",
    "license-checker": "^25.0.1",
    "markdownlint-cli2": "^0.23.3",
    "repnix": "1.1.0",
    "size-limit": "^14.1.0",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
