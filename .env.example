# Copy to .env.local. Keep all Spaces credentials server-side.
PERMINISTER_SPACES_ENDPOINT=
PERMINISTER_SPACES_REGION=
PERMINISTER_SPACES_BUCKET=
PERMINISTER_SPACES_ACCESS_KEY=
PERMINISTER_SPACES_SECRET_KEY=
# Stable random secret (32+ characters); rebuilding the email index is required to rotate it.
PERMINISTER_IDENTITY_INDEX_SECRET=

# Comma-separated account emails for restricted platform operations.
PERMINISTER_ADMIN_EMAILS=

# First-party server clients for product login and auth APIs. Keep these secrets server-side.
# Set the IDs to the product clients you deploy, then configure each matching secret below.
PERMINISTER_APP_CLIENT_IDS=
# PERMINISTER_APP_CLIENT_VISITORING_SECRET=
# PERMINISTER_APP_CLIENT_VISITORING_NAME=Visitoring
# PERMINISTER_APP_CLIENT_VISITORING_PRODUCT_ID=visitoring
# Optional origin for app-branded verification and recovery links.
# PERMINISTER_APP_CLIENT_VISITORING_ORIGIN=https://visitoring.example.com
# PERMINISTER_APP_CLIENT_POSTPARTICLE_SECRET=
# PERMINISTER_APP_CLIENT_POSTPARTICLE_NAME=PostParticle
# PERMINISTER_APP_CLIENT_POSTPARTICLE_PRODUCT_ID=postparticle
# PERMINISTER_APP_CLIENT_POSTPARTICLE_ORIGIN=https://postparticle.example.com

# Used only to build one-time email links. Keep localhost for local development.
PERMINISTER_PUBLIC_ORIGIN=http://localhost:3000

# Optional Resend transactional email. Use a sender address from a verified Resend domain.
# Email verification, password recovery, and organization invitations need these values.
RESEND_API_KEY=
PERMINISTER_MAIL_FROM=
