# Copy to .env.local. Keep all Spaces credentials server-side.
# Existing DigitalOcean Space bucket: perminister in SFO3.
PERMINISTER_SPACES_ENDPOINT=https://perminister.sfo3.digitaloceanspaces.com
PERMINISTER_SPACES_REGION=sfo3
PERMINISTER_SPACES_BUCKET=perminister
PERMINISTER_SPACES_ACCESS_KEY=
PERMINISTER_SPACES_SECRET_KEY=
