# Copy this file to deploy/self-hosted/.env.s3 and chmod it to 600.
PERMINISTER_DEPLOYMENT_PROFILE=self-hosted
PERMINISTER_STORAGE_BACKEND=s3
PERMINISTER_IMAGE=perminister:self-hosted
PERMINISTER_S3_ENDPOINT=https://s3.internal.example.com
PERMINISTER_S3_BUCKET=perminister-auth
PERMINISTER_S3_REGION=us-east-1
PERMINISTER_S3_FORCE_PATH_STYLE=true
PERMINISTER_S3_ACCESS_KEY=replace-with-access-key
PERMINISTER_S3_SECRET_KEY=replace-with-secret-key
PERMINISTER_IDENTITY_INDEX_SECRET=replace-with-at-least-32-random-characters
PERMINISTER_PUBLIC_ORIGIN=https://perminister.example.com
PERMINISTER_OIDC_ISSUER=https://perminister.example.com
PERMINISTER_ADMIN_EMAILS=admin@example.com
PERMINISTER_OPERATOR_NAME=Example Organization
PERMINISTER_PRIVACY_EMAIL=privacy@example.com
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Internal mail relay; omission disables verification, recovery, and invitation email.
PERMINISTER_MAIL_PROVIDER=smtp
PERMINISTER_SMTP_URL=smtps://username:password@mail.example.com:465
PERMINISTER_SMTP_REQUIRE_TLS=true
PERMINISTER_MAIL_FROM=Perminister <perminister@example.com>

# Optional organization login via any standards-compliant OpenID Connect provider.
# PERMINISTER_LOGIN_OIDC_ISSUER=https://identity.example.com/realms/company
# PERMINISTER_LOGIN_OIDC_CLIENT_ID=perminister
# PERMINISTER_LOGIN_OIDC_CLIENT_SECRET=replace-with-client-secret
# PERMINISTER_LOGIN_OIDC_NAME=Company SSO
